# Copy this file to .env for local development only.
# Do not commit real secrets.

# HTTP listener.
HOST=0.0.0.0
PORT=9090

# PostgreSQL connection used by the server and migration command.
DATABASE_URL=postgres://meslite:meslite@localhost:5432/meslite?sslmode=disable
MIGRATIONS_DIR=migrations

# Required for the server. Use a high-entropy value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-local-development-secret

# Optional bootstrap admin. Set both values together or leave both empty.
# AUTH_BOOTSTRAP_EMAIL=admin@example.com
# AUTH_BOOTSTRAP_PASSWORD=replace-with-a-local-development-password

# Logging and tracing.
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_TRACES_EXPORTER=none
