#!/bin/sh
# Pre-commit hook: run go vet on staged .go files

STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$')
if [ -z "$STAGED_GO" ]; then
    exit 0
fi

# Check formatting
UNFORMATTED=$(gofmt -l "$STAGED_GO")
if [ -n "$UNFORMATTED" ]; then
    echo "Unformatted Go files (run 'go fmt' to fix):"
    echo "$UNFORMATTED"
    exit 1
fi

# Run go vet on the staged packages
go vet ./...
